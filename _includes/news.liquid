<div class="news">
  {% assign filtered_news = site.news | where: 'show_on_news', true | sort: 'date' | reverse %}

  {% if filtered_news != blank %}
    {% assign news_size = filtered_news | size %}
    {% if include.limit and page.announcements.limit %}
      {% assign news_limit = page.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}

    <ul class="news-list {% if include.limit and page.announcements.scrollable and news_size > 3 %}news-scroll{% endif %}">
      {% for item in filtered_news limit: news_limit %}
        <li>
          <time datetime="{{ item.date | date: '%Y-%m' }}">{{ item.date | date: '%b %d, %Y' }}</time>
          <span>
            {% if item.inline %}
              {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
            {% else %}
              <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
            {% endif %}
          </span>
        </li>
      {% endfor %}
    </ul>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
